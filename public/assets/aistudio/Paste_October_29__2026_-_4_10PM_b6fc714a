      }
    } else {
      // 2. If no slug/hash is found in URL, load the default live market chart URL
      iframe.src = defaultChartUrl;

      var container = document.getElementById(&#39;chartContainer&#39;);
      if (container) {
        container.style.display = &#39;block&#39;;
      }
