                    &lt;td&gt;Mia Goth&lt;/td&gt;
                    &lt;td&gt;The Starlet / The Monster / Iconic.&lt;/td&gt;
                &lt;/tr&gt;
                &lt;tr&gt;
                    &lt;td&gt;&lt;strong&gt;The Killer&lt;/strong&gt;&lt;/td&gt;
                    &lt;td&gt;Unknown / Supernatural force&lt;/td&gt;
