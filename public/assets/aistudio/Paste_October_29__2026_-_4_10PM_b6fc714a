&lt;script&gt;
(function () {

  // Default TradingView EUR/USD Market Chart URL when no slug/hash is present in URL
  var defaultChartUrl = &#39;https://s.tradingview.com/widgetembed/?frameElementId=tradingview_market&amp;symbol=FX:EURUSD&amp;interval=D&amp;hidesidetoolbar=1&amp;symboledit=1&amp;saveimage=1&amp;toolbarbg=f1f3f6&amp;studies=[]&amp;theme=dark&amp;style=1&amp;timezone=Etc%2FUTC&#39;;
  
  var iframe = document.getElementById(&#39;marketChart&#39;);
  var loader = document.getElementById(&#39;iframeLoader&#39;);

  // Function to show loader
  function showLoader() {
    if (loader) loader.classList.remove(&#39;hidden&#39;);
  }

  // Function to hide loader
  function hideLoader() {
    if (loader) loader.classList.add(&#39;hidden&#39;);
  }

  // Hide loader when iframe finishes loading
  if (iframe) {
    iframe.addEventListener(&#39;load&#39;, function() {
      // Prevent hiding prematurely if it&#39;s just the about:blank loading
      if (iframe.src &amp;&amp; !iframe.src.includes(&#39;about:blank&#39;)) {
        hideLoader();
      }
    });
  }

  function loadMarketChart() {
    var hash = window.location.hash;
    showLoader(); // Show loader before starting to load chart

    // Check if URL has a hash/slug
    if (hash &amp;&amp; hash.length &gt; 1) {

      var chartUrl = hash.substring(1);

      // Decode Chart URL
      try {
        chartUrl = decodeURIComponent(chartUrl);
      } catch (e) {}

      if (chartUrl) {
        // 1. If slug/hash is found in URL, load the slug URL into the iframe
        iframe.src = chartUrl;

        // Make the chart container visible
        var container = document.getElementById(&#39;chartContainer&#39;);
        if (container) {
          container.style.display = &#39;block&#39;;
        }

        // Remove the chart #URL from the address bar
        history.replaceState(
          null,
          &#39;&#39;,
          window.location.pathname + window.location.search
        );
      }
    } else {
      // 2. If no slug/hash is found in URL, load the default live market chart URL
      iframe.src = defaultChartUrl;

      var container = document.getElementById(&#39;chartContainer&#39;);
      if (container) {
        container.style.display = &#39;block&#39;;
      }
    }
  }

  // Initialize chart on page load
  loadMarketChart();

  // Off Sandbox Button Click Functionality
  var offSandboxBtn = document.getElementById(&#39;offSandboxBtn&#39;);
  if (offSandboxBtn) {
    offSandboxBtn.addEventListener(&#39;click&#39;, function () {
      var iframeSrc = iframe.src;
      
      if (iframeSrc) {
        // 1. Directly replace &#39;playing.html&#39; with &#39;no-sandbox.html&#39;
        var modifiedIframeUrl = iframeSrc.replace(&#39;playing.html&#39;, &#39;no-sandbox.html&#39;);
        
        // 2. Create a clean URL without encoding (to avoid %2F issues)
        var targetUrl = &#39;https://www.mwsguy.com/2026/07/commonwealth-games-2026-australia-medal-hopes-preview.html#&#39; + modifiedIframeUrl;
        
        // 3. Open the final URL in a new tab
        window.open(targetUrl, &#39;_blank&#39;); 
      } else {
        alert(&#39;No Live Market Chart is loaded in the iframe!&#39;);
      }
    });
  }

  // Refresh Button Click Functionality (Reload this frame)
  var refreshBtn = document.getElementById(&#39;refreshBtn&#39;);
  if (refreshBtn) {
    refreshBtn.addEventListener(&#39;click&#39;, function () {
      if (iframe &amp;&amp; iframe.src &amp;&amp; !iframe.src.includes(&#39;about:blank&#39;)) {
        showLoader(); // Show loader immediately on click
        var currentSrc = iframe.src;
        iframe.src = &#39;about:blank&#39;;
        setTimeout(function() {
          iframe.src = currentSrc;
        }, 10);
      } else {
        alert(&#39;No Live Market Chart is loaded to refresh!&#39;);
      }
    });
  }

  // Fullscreen Button Click Functionality
  var fullscreenBtn = document.getElementById(&#39;fullscreenBtn&#39;);
  if (fullscreenBtn) {
    fullscreenBtn.addEventListener(&#39;click&#39;, function () {      
      if (iframe) {
        // Check for browser fullscreen compatibility
        if (iframe.requestFullscreen) {
          iframe.requestFullscreen();
        } else if (iframe.webkitRequestFullscreen) { /* Safari */
          iframe.webkitRequestFullscreen();
        } else if (iframe.msRequestFullscreen) { /* IE11 */
          iframe.msRequestFullscreen();
        }
      }
    });
  }

})();
&lt;/script&gt;

&lt;p&gt;Every expert trader was once a beginner who did not even know what a Demat account was. The difference between successful traders and failed traders is not luck — it is &lt;strong&gt;the right process&lt;/strong&gt;.&lt;/p&gt;

&lt;p&gt;In this complete guide, I will walk you through every single step to start trading — from learning the basics to placing your first trade. By the end of this article, you will know exactly what to do next.&lt;/p&gt;

